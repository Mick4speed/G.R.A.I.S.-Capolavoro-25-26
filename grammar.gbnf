#GRAMMAR  FILE
#DO NOT USE NOT STABLE
#TODO Update after adding a new tool
root              ::= ws "{" ws "\"action\" : " action-id additional-fields ws "}" ws
action-id         ::= [0-2]
additional-fields ::= (", \n" key-value)+
key-value         ::= " " key ws ":" ws value

value             ::= string | number | "true" | "false" | "null"
key               ::= "\"response\"" | "\"query\"" | "\"url\""
string            ::= "\"" ([^\"\\\x00-\x1f] | "\\" ["\\/bfnrt])* "\""
number            ::= [0-9]+ ("." [0-9]+)?
ws                ::= [ \t]*